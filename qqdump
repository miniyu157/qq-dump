#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# 优先使用系统 python3；没有时由 uv 查找解释器，在仓库目录下查找会优先使用其中的 .venv
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v uv >/dev/null 2>&1 && PYTHON="$(cd -- "$SCRIPT_DIR" && uv python find 2>/dev/null)"; then
    :
else
    printf "未找到 python3，也无法通过 uv 找到 Python 解释器\n" >&2
    exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/main.py" "$@"
